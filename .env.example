# Copy to .env in the repository root. Never commit the filled-in .env.
# You can run the prepared demo without model keys; custom characters/scenes need valid provider credentials.
APP_ORIGIN=http://127.0.0.1:3000
DATABASE_URL=sqlite:///./work/echoloom.db
IMAGE_DIRECTORY=work/portraits
LLM_PROVIDER=openai
LLM_MODEL=
LLM_API_KEY=
IMAGE_PROVIDER=openai
IMAGE_MODEL=
IMAGE_API_KEY=
STORY_MAX_CONTEXT_TOKENS=24000
STORY_MAX_OUTPUT_TOKENS=3500
ALLOW_ADDITIONAL_ACCOUNTS=false
# Disabled while extracting marketplace core from legacy companion application.
COMPANION_WORKER_ENABLED=false
MEMORY_ENABLED=false
CHAT_MEMORY_ENABLED=false
# Devnet only; enable after wallet binding and verification are integrated.
SOLANA_PAYMENTS_ENABLED=false
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_PROGRAM_ID=DDNC5iENR2hGuqYUWdng2Yru94YugtJLf37QEqutVH4J
SOLANA_MINT=8APFzFSd3uFnYSojta6j198bTndRoWCfhx6YxXwu7h2V
SOLANA_CONFIG_PDA=9FcbxfJejy34TDxtQkNPp4R5LsB6q8gfx1dJb2S6PiAa
SOLANA_PLATFORM_WALLET=2Y6iE7Fev4GzfmEtFXBrgy47T82ATxxib9ViRPiuzMC2
SOLANA_DEPLOYMENT_DOMAIN_HASH=7fd12cd1cd604a1789ce37dce563043aaea9f06c0e81f00d851c6cbce92d237a
# Expected public signer from the initialized Devnet configuration (NOT a private key).
SOLANA_EXPECTED_SIGNER_PUBKEY=Dj1g1qvkbKtrVzzSuYqZ4zC7QRxEneU8jh5CYMo36Cxb
# Path to your OWN secure 64-byte Solana CLI keypair whose public key matches above.
# Coordinate an on-chain signer rotation instead of transmitting a teammate's private key.
# Keep payments disabled until signer custody, buyer tokens and creator verification are ready.
# Path to a private Solana CLI keypair outside the repository.
SOLANA_BACKEND_SIGNER_PATH=

SOLANA_PAYMENT_COMMITMENT=finalized

# Explicit Devnet demo opt-in; keep false for administrator-approved onboarding.
SOLANA_CREATOR_SELF_SERVICE_ENABLED=false

# ElevenLabs approved existing-voice catalog; no voice cloning or custom voice design.
ELEVENLABS_ENABLED=false
ELEVENLABS_API_KEY=
# Comma-separated approved voice IDs from My Voices (prefer Infinity voices).
ELEVENLABS_VOICE_IDS=
ELEVENLABS_CATALOG_TTL_SECONDS=3600
ELEVENLABS_TIMEOUT_SECONDS=15

# Explicit opt-in for billable dialogue auditions and story audio.
ELEVENLABS_AUDIO_ENABLED=false
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_NARRATOR_VOICE_ID=
ELEVENLABS_AUDIO_DIRECTORY=work/voice-audio
ELEVENLABS_AUDIO_DAILY_CHARS=5000
ELEVENLABS_AUDIO_GLOBAL_DAILY_CHARS=20000

# Autonomous character research (server only; default off).
FIRECRAWL_ENABLED=false
FIRECRAWL_API_KEY=
FIRECRAWL_MAX_CREDITS=100
FIRECRAWL_TIMEOUT_SECONDS=90
FIRECRAWL_DAILY_RUNS_PER_ACCOUNT=5
FIRECRAWL_DAILY_RUNS_GLOBAL=20
