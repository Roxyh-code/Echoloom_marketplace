# Copy to .env in the repository root. Never commit the filled-in .env.
# You can run the prepared demo without model keys; custom characters/scenes need valid provider credentials.
APP_ORIGIN=http://127.0.0.1:3000
DATABASE_URL=sqlite:///./work/echoloom.db
IMAGE_DIRECTORY=work/portraits
LLM_PROVIDER=openai
LLM_MODEL=
LLM_API_KEY=
IMAGE_PROVIDER=openai
IMAGE_MODEL=
IMAGE_API_KEY=
STORY_MAX_CONTEXT_TOKENS=24000
STORY_MAX_OUTPUT_TOKENS=3500
ALLOW_ADDITIONAL_ACCOUNTS=false
# Disabled while extracting marketplace core from legacy companion application.
COMPANION_WORKER_ENABLED=false
MEMORY_ENABLED=false
CHAT_MEMORY_ENABLED=false
# Wallet and Solana config will be defined and documented in a later phase.
